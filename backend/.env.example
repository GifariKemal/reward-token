# Salin ke .env lalu isi. .env di-ignore git, .env.example boleh commit.
# Semua baris opsional: yang dikosongkan hanya mematikan fitur terkait,
# indexer dan endpoint baca tetap jalan.

# RPC endpoint utama. Dicoba pertama, sisanya fallback di src/config.ts.
# CATATAN: block deploy factory ini (121410684) sudah dipangkas di banyak RPC
# publik. Yang masih menyajikannya: https://97.rpc.thirdweb.com
RPC_URL=https://bsc-testnet.drpc.org

# Port API Hono
PORT=3000

# Lebar jendela getLogs. Default 999 supaya muat di semua RPC gratis (thirdweb
# menolak lebih dari 1000). drpc mengizinkan sampai 10.000, jadi menyusulkan riwayat
# panjang bisa jauh lebih cepat, tapi hanya kalau daftar RPC-nya memang drpc saja.
# CHUNK=999

# Lokasi berkas SQLite. Dipakai test supaya tidak menyentuh basis data sungguhan.
# DB_PATH=papan-sayembara.db

# --- Wallet 1: relayer, untuk endpoint tulis (/relay/*) ---
# Bayar gas DAN RWD-nya yang dipakai jadi hadiah. Kosong = /relay/* balas 503.
RELAYER_PK=

# --- Wallet 2: juri, untuk `bun oracle` ---
# Cuma butuh tBNB untuk gas, tapi alamatnya WAJIB terdaftar sebagai oracle di
# factory (lihat setOracle), kalau tidak fulfillVerification revert BukanOracle.
# Kosong = juri mati, API tetap jalan.
ORACLE_PK=

# --- LLM juri: endpoint OpenAI-compatible, provider bebas tanpa ubah kode ---
# OpenAI langsung:
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# atau lewat OpenRouter (bisa pakai model Claude):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-sonnet-4.5
# atau Groq (gratis, cepat):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# atau GLM lewat Z.ai (yang dipakai dan diuji di sini, glm-4.5-air gratis):
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL=glm-4.5-air
LLM_API_KEY=

# Jeda polling juri
POLL_INTERVAL_SECONDS=15
